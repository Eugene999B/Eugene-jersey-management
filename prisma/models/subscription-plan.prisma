enum SubscriptionPlanChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model SubscriptionPlan {
  id                    String   @id @default(cuid())
  tier                  PlanTier @unique
  name                  String
  description           String?
  currency              String   @default("GHS")
  monthlyPrice          Decimal? @db.Decimal(12, 2)
  yearlyPrice           Decimal? @db.Decimal(12, 2)
  trialDays             Int      @default(14)
  gracePeriodDays       Int      @default(7)
  includedStaffAccounts Int?
  maxProducts           Int?
  maxOrdersPerMonth     Int?
  features              String[] @default([])
  isConfigured          Boolean  @default(false)
  isPublic              Boolean  @default(false)
  isActive              Boolean  @default(true)
  version               Int      @default(1)
  createdById           String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  versions       SubscriptionPlanVersion[]
  changeRequests SubscriptionPlanChangeRequest[]
  contracts      ShopSubscriptionContract[]

  @@index([isActive, isConfigured, isPublic])
}

model SubscriptionPlanVersion {
  id           String   @id @default(cuid())
  planId       String
  version      Int
  snapshot     Json
  reason       String
  approvedById String
  createdAt    DateTime @default(now())

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([planId, createdAt])
}

model SubscriptionPlanChangeRequest {
  id               String                       @id @default(cuid())
  planId           String
  basePlanVersion  Int
  status           SubscriptionPlanChangeStatus @default(PENDING)
  reason           String
  decisionNote     String?
  previousSnapshot Json
  proposedSnapshot Json
  requestedById    String
  decidedById      String?
  createdAt        DateTime                     @default(now())
  decidedAt        DateTime?

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([planId, status])
  @@index([requestedById, createdAt])
}

model ShopSubscriptionContract {
  id                 String             @id @default(cuid())
  shopId             String             @unique
  planId             String
  planVersion        Int
  billingCycle       BillingCycle
  subscriptionStatus SubscriptionStatus
  monthlyPrice       Decimal?           @db.Decimal(12, 2)
  yearlyPrice        Decimal?           @db.Decimal(12, 2)
  trialEndsAt        DateTime?
  renewalAt          DateTime?
  graceEndsAt        DateTime?
  termsSnapshot      Json
  assignedById       String?
  assignmentReason   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, subscriptionStatus])
  @@index([subscriptionStatus, renewalAt])
}
