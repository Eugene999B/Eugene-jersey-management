enum CustomerProductionRequestStatus {
  SUBMITTED
  QUOTED
  PREVIEW_READY
  CHANGES_REQUESTED
  APPROVED
  DEPOSIT_PAID
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
}

enum CustomerProductionEventType {
  SUBMITTED
  ARTWORK_ATTACHED
  QUOTED
  PREVIEW_READY
  APPROVED
  CHANGES_REQUESTED
  ORDER_CREATED
  DEPOSIT_PAID
  PRODUCTION_STARTED
  READY
  BALANCE_PAID
  COMPLETED
  CANCELLED
  NOTE
}

model CustomerProductionRequest {
  id                   String                          @id @default(cuid())
  shopId               String
  buyerId              String
  productVariantId     String
  publicAccessToken    String                          @unique
  status               CustomerProductionRequestStatus @default(SUBMITTED)
  title                String
  productSnapshot      Json
  garmentResourceId    String
  garmentSnapshot      Json
  garmentSize          String
  placementResourceId  String
  placementSnapshot    Json
  requestedText        String?
  requestedNumber      String?
  requestNotes         String?
  fulfillmentType      FulfillmentType                 @default(PICKUP)
  deliveryAddress      String?
  deliveryCity         String?
  deliveryArea         String?
  deliveryNotes        String?
  quotedTotal          Decimal?                        @db.Decimal(12, 2)
  depositAmount        Decimal?                        @db.Decimal(12, 2)
  previewSvg           String?
  previewVersion       Int                             @default(0)
  previewNote          String?
  quoteExpiresAt       DateTime?
  orderId              String?                         @unique
  quotedAt             DateTime?
  previewReadyAt       DateTime?
  approvedAt           DateTime?
  depositPaidAt        DateTime?
  balancePaidAt        DateTime?
  productionStartedAt  DateTime?
  readyAt              DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([shopId, status, updatedAt])
  @@index([buyerId, updatedAt])
  @@index([shopId, buyerId, updatedAt])
  @@index([orderId])
}

model CustomerProductionAsset {
  id          String   @id @default(cuid())
  shopId      String
  requestId   String
  buyerId     String
  originalName String
  mimeType    String
  byteLength  Int
  sha256      String
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([shopId, requestId, createdAt])
  @@index([buyerId, createdAt])
}

model CustomerProductionEvent {
  id           String                      @id @default(cuid())
  shopId       String
  requestId    String
  type         CustomerProductionEventType
  note         String?
  metadata     Json?
  actorBuyerId String?
  actorUserId  String?
  createdAt    DateTime                    @default(now())

  @@index([shopId, requestId, createdAt])
  @@index([requestId, createdAt])
}
