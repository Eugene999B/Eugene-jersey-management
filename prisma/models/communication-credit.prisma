enum CommunicationCreditChannel {
  SMS
  WHATSAPP
}

enum CommunicationCreditPackageChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CommunicationCreditPurchaseStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum CommunicationCreditLedgerType {
  PURCHASE
  USAGE
  REFUND
  ADJUSTMENT
}

model CommunicationCreditPackage {
  id            String   @id @default(cuid())
  code          String   @unique
  channel       CommunicationCreditChannel
  name          String
  description   String?
  currency      String   @default("GHS")
  price         Decimal? @db.Decimal(12, 2)
  creditUnits   Int?
  bonusUnits    Int      @default(0)
  isConfigured  Boolean  @default(false)
  isPublic      Boolean  @default(false)
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions       CommunicationCreditPackageVersion[]
  changeRequests CommunicationCreditPackageChangeRequest[]
  purchases      CommunicationCreditPurchase[]

  @@index([channel, isActive, isConfigured, isPublic])
}

model CommunicationCreditPackageVersion {
  id           String   @id @default(cuid())
  packageId    String
  version      Int
  snapshot     Json
  reason       String
  approvedById String
  createdAt    DateTime @default(now())

  package CommunicationCreditPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, version])
  @@index([packageId, createdAt])
}

model CommunicationCreditPackageChangeRequest {
  id               String                                 @id @default(cuid())
  packageId        String
  baseVersion      Int
  status           CommunicationCreditPackageChangeStatus @default(PENDING)
  reason           String
  decisionNote     String?
  previousSnapshot Json
  proposedSnapshot Json
  requestedById    String
  decidedById      String?
  createdAt        DateTime                               @default(now())
  decidedAt        DateTime?

  package CommunicationCreditPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([packageId, status])
  @@index([requestedById, createdAt])
}

model ShopCommunicationWallet {
  id                String                     @id @default(cuid())
  shopId            String
  channel           CommunicationCreditChannel
  balance           Int                        @default(0)
  lifetimePurchased Int                        @default(0)
  lifetimeUsed      Int                        @default(0)
  lifetimeRefunded  Int                        @default(0)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([shopId, channel])
  @@index([shopId, updatedAt])
}

model CommunicationCreditPurchase {
  id                String                            @id @default(cuid())
  shopId            String
  packageId         String
  packageVersion    Int
  channel           CommunicationCreditChannel
  creditUnits       Int
  bonusUnits        Int                               @default(0)
  totalUnits        Int
  amount            Decimal                           @db.Decimal(12, 2)
  currency          String
  status            CommunicationCreditPurchaseStatus @default(PENDING)
  provider          String                            @default("PAYSTACK")
  providerReference String                            @unique
  packageSnapshot   Json
  initiatedById     String
  verifiedAt        DateTime?
  failedAt          DateTime?
  gatewayResponse   String?
  providerChannel   String?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt

  package       CommunicationCreditPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  ledgerEntries CommunicationCreditLedgerEntry[]

  @@index([shopId, status, createdAt])
  @@index([packageId, createdAt])
}

model CommunicationCreditLedgerEntry {
  id                String                        @id @default(cuid())
  shopId            String
  channel           CommunicationCreditChannel
  type              CommunicationCreditLedgerType
  delta             Int
  balanceAfter      Int
  reference         String                        @unique
  purchaseId        String?
  customerMessageId String?
  reason            String
  createdById       String?
  metadata          Json                          @default("{}")
  createdAt         DateTime                      @default(now())

  purchase CommunicationCreditPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([shopId, channel, createdAt])
  @@index([purchaseId])
  @@index([customerMessageId])
}
