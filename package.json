{
  "name": "eugene-shop-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "biome lint . --max-diagnostics=200",
    "test": "vitest run",
    "test:e2e": "npm --prefix e2e test",
    "test:tenant-isolation": "tsx scripts/verify-tenant-isolation.ts && tsx scripts/verify-release26-platform-isolation.ts && tsx scripts/verify-release27-email-isolation.ts && tsx scripts/verify-release28-recovery-isolation.ts",
    "test:release26-isolation": "tsx scripts/verify-release26-platform-isolation.ts",
    "test:release27-isolation": "tsx scripts/verify-release27-email-isolation.ts",
    "test:release28-isolation": "tsx scripts/verify-release28-recovery-isolation.ts",
    "e2e:seed": "tsx scripts/seed-e2e.ts && tsx scripts/seed-release25-e2e.ts && tsx scripts/seed-release26-e2e.ts && tsx scripts/seed-release28-e2e.ts && tsx scripts/seed-release30-e2e.ts && tsx scripts/seed-release38-e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "production:activate": "tsx scripts/activate-production.ts",
    "production:purge-demo": "tsx scripts/purge-demo-data.ts",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:handoff": "tsx scripts/generate-handoff-doc.ts",
    "jobs:release-reservations": "tsx scripts/release-expired-reservations.ts",
    "jobs:subscriptions": "tsx scripts/process-subscription-lifecycle.ts",
    "setup:demo": "prisma generate && prisma db push && tsx prisma/seed.ts --demo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "sharp": "^0.35.3",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "fast-uri": "4.1.1",
    "postcss": "^8.5.10",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  }
}
