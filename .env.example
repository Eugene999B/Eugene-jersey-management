DATABASE_URL="postgresql://sports_shop:sports_shop_password@localhost:5432/sports_shop_platform?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
TWO_FACTOR_ENCRYPTION_KEY="replace-with-a-different-long-random-secret-at-least-32-characters"
APP_URL="http://localhost:3000"

# Optional release-tier override. Railway automatically treats its environment named
# "production" as production and every other Railway environment as staging.
# Leave blank normally; use only when an environment intentionally needs an override.
ESM_DEPLOYMENT_TIER=""

# Local demo data only. Never use a production password here.
SEED_DEMO_PASSWORD="replace-with-a-unique-demo-password-12-plus-characters"
SAFE_DEMO_SEED="false"

# Production platform administrator. Railway production deploy runs production:activate.
ADMIN_EMAIL="admin@example.com"
ADMIN_LOGIN_ID="EJM-ADMIN-ROOT"
ADMIN_NAME="Platform Super Admin"
ADMIN_PHONE=""
ADMIN_PASSWORD="replace-with-a-strong-private-password-12-plus-characters"
ADMIN_FORCE_RESET="false"

# One-time production cleanup. Leave blank normally.
# Set exactly to PURGE-ACC-PRO-DEMO-2026 for one deploy, then remove it.
PURGE_DEMO_DATA=""

# ESM administrator/main Paystack account. Store sales use shop subaccounts under this integration.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_PLATFORM_ACCOUNT_LABEL="ESM administrator main account"
PAYSTACK_TIMEOUT_MS="15000"

SMS_PROVIDER="console"
ARKESEL_API_KEY=""
ARKESEL_SENDER_ID="ESM"
SMS_API_URL=""
SMS_API_TOKEN=""
MESSAGE_PROVIDER_TIMEOUT_MS="12000"

# Transactional email used for buyer verification and password recovery codes.
# Gmail OAuth is suitable for the company Gmail mailbox. Grant: openid, email and gmail.send.
EMAIL_PROVIDER="console"
EMAIL_FROM="Eugene Shop Management <eugenejerseymanagement@gmail.com>"
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
# Optional Resend alternative. EMAIL_FROM must then use a verified Resend sending domain.
RESEND_API_KEY=""
EMAIL_PROVIDER_TIMEOUT_MS="12000"
# Signing secret from the Resend webhook details page. It is unused when EMAIL_PROVIDER=gmail.
RESEND_WEBHOOK_SECRET=""

WHATSAPP_PROVIDER="console"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
# Must be a separate read-only HTTPS endpoint. Never point health checks at a send-message endpoint.
WHATSAPP_HEALTH_URL=""

# Durable PostgreSQL media is the default and needs no extra credentials.
# Optional alternatives: local (development only), r2, or s3.
MEDIA_STORAGE_PROVIDER="database"
MEDIA_PUBLIC_URL=""
MAX_IMAGE_UPLOAD_BYTES="20971520"
MAX_IMAGE_INPUT_PIXELS="50000000"
ALLOW_EPHEMERAL_MEDIA="false"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_REGION="auto"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Authenticated scheduler endpoint: POST /api/jobs/release-reservations
JOBS_API_TOKEN="replace-with-a-long-random-job-token-at-least-32-characters"
RESERVATION_JOB_INTERVAL_MINUTES="15"
INTEGRATION_HEALTH_TIMEOUT_MS="8000"